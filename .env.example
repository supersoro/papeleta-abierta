# Clave de la API de Anthropic (console.anthropic.com). Solo en servidor.
ANTHROPIC_API_KEY=
# Modelo para el buscador
ANTHROPIC_MODEL=claude-sonnet-5-5
# Límites de uso
RATE_LIMIT_PER_MINUTE=5
DAILY_LIMIT=2000
# Opcional, recomendado en producción: Upstash Redis para que los límites se compartan entre instancias
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
