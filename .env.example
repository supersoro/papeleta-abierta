# Clave de la API de Anthropic (console.anthropic.com). Solo en servidor.
ANTHROPIC_API_KEY=
# Modelo para el buscador
ANTHROPIC_MODEL=claude-haiku-4-5
# Límites de uso. En Vercel hace falta Upstash Redis para que el tope diario sea real.
RATE_LIMIT_PER_MINUTE=8
DAILY_LIMIT=400
# Opcional, recomendado en producción: Upstash Redis para que los límites se compartan entre instancias
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
